{
  "name": "porchlight",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:beta": "vue-tsc -b && vite build --mode beta",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-porchlight \"vitest run --config vitest.rules.config.ts\"",
    "test:functions": "firebase emulators:exec --only auth,firestore,storage --project demo-porchlight \"vitest run --config tests/functions/vitest.emulator.config.ts\"",
    "test:e2e": "node scripts/e2e.mjs",
    "emulators": "firebase emulators:start --project demo-porchlight --import=.emulator-data --export-on-exit=.emulator-data",
    "seed": "tsx scripts/seed.ts",
    "places:build": "tsx scripts/buildPlaces.ts",
    "icons:build": "tsx scripts/buildIcons.ts",
    "events:create": "tsx scripts/createEvents.ts",
    "testers": "tsx scripts/setTesters.ts",
    "admin": "tsx scripts/setAdmin.ts",
    "moderate": "tsx scripts/moderate.ts"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@ionic/vue": "^9.0.6",
    "@ionic/vue-router": "^9.0.6",
    "firebase": "^12.19.0",
    "geofire-common": "^6.0.0",
    "ionicons": "^8.1.0",
    "maplibre-gl": "^6.11.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "adm-zip": "^0.6.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.0",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "volta": {
    "node": "22.23.3",
    "npm": "10.9.9"
  }
}
