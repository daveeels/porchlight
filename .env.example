# Copy to .env.local and fill in. All VITE_* values end up in the browser bundle
# and are public by design — never put secrets here.

# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
# Must be the same domain the app is served from (SPEC F4): <project>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Map styles (MapLibre style JSON URLs). Optional: the defaults are
# OpenFreeMap's public styles, which need no key. Override to switch provider.
# VITE_MAP_STYLE_HALLOWEEN=https://tiles.openfreemap.org/styles/dark
# VITE_MAP_STYLE_CHRISTMAS=https://tiles.openfreemap.org/styles/positron

# Dev only: connect to local emulators instead of the real project
VITE_USE_EMULATORS=true

# Beta builds only (SPEC §5 beta mode): adds <meta name="robots" content="noindex">.
# Remove (or set false) for the LIVE launch build.
VITE_NOINDEX=true
