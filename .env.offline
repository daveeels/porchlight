# Offline mode: `npm run offline` (vite --mode offline).
# Everything runs against the local Firebase emulators as the offline
# `demo-porchlight` project — no real data is read or written.
# A mode file beats .env.local in Vite, so nobody needs to edit .env.local
# for local testing (that file must keep the real project for deploys).
# None of these are secrets.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-porchlight.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-porchlight
VITE_FIREBASE_STORAGE_BUCKET=demo-porchlight.appspot.com
VITE_FIREBASE_APP_ID=demo-app-id
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
